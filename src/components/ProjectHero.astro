---
import ProjectPhoto from './ProjectPhoto.astro'

interface Props {
  description: string
  heroImage?: string
}

const { description, heroImage } = Astro.props
---

<section class="hero" id="project-hero">
  <div class="contentLayer">
    <p class="heroTitle">{description}</p>
    {
      heroImage && (
        <div class="mockupWrapper" id="hero-mockup">
          <ProjectPhoto>
            <img class="photoMedia" src={heroImage} alt="" loading="eager" />
          </ProjectPhoto>
        </div>
      )
    }
  </div>
</section>

<style>
  .hero {
    position: relative;
    width: 100%;
    min-height: min(90vh, 52rem);
    max-height: none;
    overflow: clip;
    border-radius: var(--panel-radius);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    padding-top: 3rem;
    padding-bottom: 2rem;
    /* background-color: var(--panel-bg, #fff); */
    /* border: var(--panel-border); */
    /* box-shadow: var(--panel-shadow); */
    opacity: 0;
    transition: opacity 0.3s;
  }

  .hero.visible {
    opacity: 1;
  }

  .contentLayer {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .heroTitle {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 500;
    line-height: 1.3;
    text-align: center;
    color: var(--text-color);
    max-width: 800px;
    will-change: transform, opacity;
    transform: translateZ(0);
  }

  .mockupWrapper {
    width: 100%;
    max-width: min(var(--project-media-max-width, 960px), 100%);
    padding-top: 1rem;
    will-change: transform;
    transform: translateZ(0);
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .hero.visible .heroTitle {
    animation: fadeIn 0.8s ease-out 0.1s 1 forwards;
    opacity: 0;
  }

  .hero.visible .mockupWrapper {
    animation: fadeIn 0.5s ease-out 0.3s 1 forwards;
    opacity: 0;
  }
</style>

<script>
  function initHeroParallax() {
    const hero = document.getElementById('project-hero')

    if (!hero) return

    hero.classList.add('visible')

    // Parallax disabled
    // const mockupWrapper = document.getElementById('hero-mockup')
    // if (!mockupWrapper) return
    //
    // let ticking = false
    // function updateParallax() {
    //   const wrap = document.getElementById('hero-mockup')
    //   if (!wrap) return
    //   const scrollY = window.scrollY
    //   wrap.style.transform = `translate3d(0px, ${scrollY * -0.6}px, 0px)`
    //   ticking = false
    // }
    //
    // function onScroll() {
    //   if (ticking) return
    //   ticking = true
    //   requestAnimationFrame(updateParallax)
    // }
    //
    // window.addEventListener('scroll', onScroll, { passive: true })
    // setTimeout(() => requestAnimationFrame(updateParallax), 700)
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeroParallax)
  } else {
    initHeroParallax()
  }
</script>
