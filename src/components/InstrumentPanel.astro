---
import Button from './Button.astro'
---

<aside class="instrument-panel">
  <div class="outpost-transition-target instrument-panel__body">
    <h1 class="instrument-panel__title">
      <span class="instrument-panel__title-line">
        <a href="/" class="instrument-panel__title-link">Ryen Beatty</a>
      </span>
      <span
        class="instrument-panel__title-line instrument-panel__title-line--sub"
        >Design Engineer</span
      >
    </h1>

    <div class="instrument-panel__actions">
      <div class="instrument-panel__social">
        <Button
          variant="tertiary"
          size="sm"
          target="_blank"
          href="https://drive.google.com/file/d/12BFWC5HB7yO27PiBPW99Rj5S8mmN0I-f/view?usp=drive_link"
          >Résumé</Button
        >
        <Button
          variant="tertiary"
          size="sm"
          target="_blank"
          href="https://www.are.na/ryen-beatty">Are.na</Button
        >
        <Button
          variant="tertiary"
          size="sm"
          target="_blank"
          href="https://github.com/ryenbeatty">Github</Button
        >
      </div>

      <Button
        variant="primary"
        size="sm"
        class="btn--message"
        target="_blank"
        href="https://www.linkedin.com/in/ryen-beatty/"
        emojiOnHover={'🛸'}
        shouldAnimateIcon>Shoot me a message</Button
      >
    </div>
  </div>

  <!-- <div class="instrument-panel__turtle">
    <SeaTurtle client:load />
  </div> -->

  <style>
    .instrument-panel {
      position: sticky;
      top: var(--layout-padding, 16px);
      align-self: start;
      width: 100%;
      height: calc(100dvh - var(--instrument-panel-inset, 32px));
      max-height: calc(100dvh - var(--instrument-panel-inset, 32px));
      min-width: 0;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
      padding: 0.5rem;
      box-sizing: border-box;
      min-height: 0;
      overflow: hidden;
      background-color: var(--panel-bg);
      border: var(--panel-border);
      border-radius: var(--panel-radius);
      box-shadow: var(--panel-shadow);
      z-index: 10;
    }

    .instrument-panel__outpost {
      position: relative;
      z-index: 2;
      width: 100%;
      flex-shrink: 0;
    }

    .instrument-panel__body {
      display: flex;
      flex-direction: column;
      justify-content: flex-start;
      align-items: flex-start;
      gap: 1rem;
      flex: 1 1 auto;
      width: 100%;
      min-height: 0;
      max-height: 100%;
      overflow-x: hidden;
      overflow-y: auto;
      overscroll-behavior: contain;
    }

    .instrument-panel__body > h1,
    .instrument-panel__actions,
    .instrument-panel__social {
      flex-shrink: 0;
    }

    .instrument-panel__actions {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
      width: 100%;
    }

    .instrument-panel__social {
      display: flex;
      flex-flow: row nowrap;
      gap: 0.25rem;
      width: 100%;
    }

    .instrument-panel__social :global(.btn),
    .instrument-panel__actions > :global(.btn) {
      min-height: 44px;
    }

    .instrument-panel__actions :global(.btn.btn--message) {
      background-color: #1a1a1a;
      border-color: #1a1a1a;
      color: #fff;
    }

    .instrument-panel__actions :global(.btn.btn--message:hover) {
      background-color: #2a2a2a;
      border-color: #2a2a2a;
      color: #fff;
    }

    .instrument-panel__social :global(.btn) {
      width: auto;
      flex: 1 1 0;
      min-width: 0;
      padding-inline: 0.4em;
      white-space: nowrap;
    }

    @media (max-width: 960px) {
      .instrument-panel {
        position: static;
        height: fit-content;
        max-height: none;
        min-height: 0;
        overflow: visible;
      }

      .instrument-panel__body {
        flex: 0 0 auto;
        flex-direction: column;
        align-items: stretch;
        height: auto;
        max-height: none;
        overflow: visible;
        gap: 0.75rem;
      }

      .instrument-panel__title {
        margin-bottom: 0;
      }

      .instrument-panel__actions {
        width: 100%;
        min-width: 0;
      }
    }

    .instrument-panel__title {
      margin: 0 0 1rem 0;
      font-size: var(--step-2);
      font-weight: 500;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 0.36em;
      line-height: 1;
    }

    .instrument-panel__title-line {
      display: block;
      line-height: 1;
    }

    .instrument-panel__title-link {
      color: inherit;
      text-decoration: none;
      transition: color 0.22s cubic-bezier(0.33, 1, 0.68, 1);
    }

    .instrument-panel__title-link:hover {
      color: color-mix(in srgb, var(--text-color) 78%, white);
    }

    .instrument-panel__title-link:focus-visible {
      outline: var(--focus-ring, 2px solid var(--site-color));
      outline-offset: 3px;
      border-radius: 2px;
    }

    .instrument-panel__title-line--sub {
      font-weight: 300;
      color: var(--gray20);
    }

    @supports (text-box-trim: trim-both) {
      .instrument-panel__title-line {
        text-box-trim: trim-both;
        text-box-edge: cap alphabetic;
      }
    }

    .instrument-panel__turtle {
      position: absolute;
      left: 0.5rem;
      right: 0.5rem;
      bottom: 0.75rem;
      height: 4.5rem;
      pointer-events: none;
      z-index: 2;
      overflow: visible;
    }

    :global([data-command-center='true'])
      .instrument-panel__actions
      :global(.theme-toggle) {
      display: none;
    }

    .instrument-panel__links {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
      width: 100%;
      flex-shrink: 0;
    }

    li {
      list-style: none;
      padding: 0;
    }

    .instrument-panel :global(.footer-links) {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
      padding: 0;
    }

    .active {
      font-weight: bold;
      text-decoration: underline;
      text-decoration-thickness: 2px;
      text-underline-offset: 3px;
    }
  </style>
</aside>
