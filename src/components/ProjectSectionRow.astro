---
import Media from './Media/index.svelte'
import ProjectPhoto from './ProjectPhoto.astro'
import {
  resolveMediaGridColumns,
  resolveMediaWidthPx,
  resolveMediaType,
} from '../utils/project-media'
import { projectHeroTransitionName } from '../utils/view-transitions'

interface MediaItem {
  src: string
  type: 'image' | 'video' | 'vidstack'
  alt?: string
  caption?: string
  poster?: string
  /** CSS pixel width; use maxWidthPx if width is missing after build */
  width?: number
  maxWidthPx?: number
}

interface Props {
  /** Rendered HTML for the section body */
  bodyHtml: string
  media: MediaItem[]
  /** Heading above body (e.g. project title) */
  title?: string
  /** When set, title is rendered as a link (e.g. for homepage index) */
  titleHref?: string
  /** First-row hero morph from project index tile (project slug) */
  heroTransitionSlug?: string
}

const { bodyHtml, media, title, titleHref, heroTransitionSlug } = Astro.props

const mediaGridColumns = resolveMediaGridColumns(media.length)
const isMediaGrid = mediaGridColumns != null
const sectionTitle = title?.trim()
const hasBody = Boolean(bodyHtml?.trim())
const showText = Boolean(sectionTitle || hasBody)

function mediaSizingStyle(width: number | undefined): string | undefined {
  if (width == null) return undefined
  return `width:${width}px;max-width:100%;height:auto;`
}

function resolveMediaWidth(item: MediaItem): number | undefined {
  return resolveMediaWidthPx(item)
}

function mediaCaption(item: MediaItem): string | undefined {
  return item.caption
}
---

<div
  class:list={[
    'project-section-row',
    !showText && 'project-section-row--media-only',
  ]}
>
  {
    showText && (
      <div class="project-section-row__text">
        {
          sectionTitle &&
            (titleHref ? (
              <h2 class="project-section-row__title">
                <a href={titleHref} class="project-section-row__title-link">
                  {sectionTitle}
                </a>
              </h2>
            ) : (
              <h2 class="project-section-row__title">{sectionTitle}</h2>
            ))
        }
        {
          hasBody && (
            <div
              class="project-section-row__body prose dark:prose-invert"
              set:html={bodyHtml}
            />
          )
        }
      </div>
    )
  }
  <div
    class:list={[
      'project-section-row__media',
      isMediaGrid && 'project-section-row__media--grid',
    ]}
    style={
      isMediaGrid
        ? `--media-grid-cols: ${mediaGridColumns}`
        : undefined
    }
  >
    {
      media.map((item, mediaIndex) => {
        const mediaType = resolveMediaType(item)
        const w = isMediaGrid ? undefined : resolveMediaWidth(item)
        const caption = mediaCaption(item)
        const isHeroTransition =
          heroTransitionSlug != null &&
          mediaIndex === 0 &&
          mediaType === 'image'

        if (mediaType === 'video') {
          return (
            <ProjectPhoto caption={caption} maxWidthPx={w}>
              <video
                src={item.src}
                autoplay
                loop
                muted
                playsinline
                preload="auto"
                class="photoMedia project-section-row__video--ambient"
                aria-label={item.alt}
                width={w}
                style={mediaSizingStyle(w)}
              />
            </ProjectPhoto>
          )
        }

        if (mediaType === 'vidstack') {
          return (
            <ProjectPhoto caption={caption} maxWidthPx={w}>
              <div
                class:list={[
                  'project-section-row__embed-wrap',
                  'project-section-row__vidstack-wrap',
                ]}
              >
                <Media
                  client:only="svelte"
                  viewType="video"
                  src={item.src}
                  title={item.alt ?? 'Video'}
                  poster={item.poster ?? ''}
                  posterAlt={item.alt ?? ''}
                />
              </div>
            </ProjectPhoto>
          )
        }

        const imgNode = isHeroTransition ? (
          <img
            src={item.src}
            alt={item.alt ?? ''}
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="photoMedia project-hero-transition-target"
            width={w}
            style={mediaSizingStyle(w)}
            transition:name={projectHeroTransitionName(heroTransitionSlug!)}
            transition:animate="initial"
          />
        ) : (
          <img
            src={item.src}
            alt={item.alt ?? ''}
            loading="lazy"
            class="photoMedia"
            width={w}
            style={mediaSizingStyle(w)}
          />
        )

        if (titleHref) {
          return (
            <ProjectPhoto caption={caption} maxWidthPx={w}>
              <a
                href={titleHref}
                class="project-section-row__media-link"
                aria-label={`View project — ${sectionTitle ?? 'project'}`}
                data-astro-prefetch="hover"
              >
                <span class="project-section-row__media-frame">
                  {imgNode}
                  <span
                    class="project-section-row__media-overlay"
                    aria-hidden="true"
                  >
                    <svg
                      class="project-section-row__media-arrow"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.75"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M5 12h14" />
                      <path d="m13 6 6 6-6 6" />
                    </svg>
                  </span>
                </span>
              </a>
            </ProjectPhoto>
          )
        }

        return (
          <ProjectPhoto caption={caption} maxWidthPx={w}>
            {imgNode}
          </ProjectPhoto>
        )
      })
    }
  </div>
</div>

<style>
  .project-section-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
    gap: var(--project-section-row-gap, 1.25rem);
  }

  .project-section-row--media-only {
    gap: 0;
  }

  .project-section-row__text {
    width: 100%;
    max-width: 40rem;
    margin: 0;
    text-align: start;
  }

  .project-section-row__title {
    margin: 0 0 0.4em;
    font-weight: 500;
  }

  .project-section-row__title-link {
    color: inherit;
    text-decoration: none;
  }

  .project-section-row__title-link:hover {
    text-decoration: underline;
  }

  .project-section-row__body {
    margin: 0;
  }

  .project-section-row__body :global(p) {
    margin: 0 0 0.65em;
  }

  .project-section-row__body :global(p:first-child) {
    margin-top: 0;
  }

  .project-section-row__body :global(p:last-child) {
    margin-bottom: 0;
  }

  .project-section-row__media {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
    gap: var(--project-section-row-gap, 1.25rem);
    width: 100%;
    max-width: min(var(--project-media-max-width, 960px), 100%);
    margin: 0;
  }

  .project-section-row__media--grid {
    grid-template-columns: repeat(var(--media-grid-cols, 2), minmax(0, 1fr));
    align-items: center;
    column-gap: 1rem;
    row-gap: 1rem;
  }

  .project-section-row__media--grid :global(.photo) {
    max-width: none;
  }

  @container page (max-width: 600px) {
    .project-section-row__media--grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 960px) {
    .project-section-row__media--grid {
      grid-template-columns: 1fr;
    }
  }

  .project-section-row__media-link {
    position: relative;
    display: block;
    color: #fff;
    outline-offset: 4px;
  }

  .project-section-row__media-frame {
    position: relative;
    display: block;
    overflow: hidden;
  }

  .project-section-row__media-link .photoMedia {
    transition:
      filter 0.28s ease,
      transform 0.35s ease;
  }

  .project-section-row__media-link:hover .photoMedia,
  .project-section-row__media-link:focus-visible .photoMedia {
    filter: brightness(0.9);
  }

  .project-section-row__media-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }

  .project-section-row__media-arrow {
    width: clamp(3rem, 12vw, 5.5rem);
    height: clamp(3rem, 12vw, 5.5rem);
    opacity: 0;
    transform: translateX(-0.35rem) scale(0.92);
    filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.35));
    transition:
      opacity 0.26s ease,
      transform 0.32s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .project-section-row__media-link:hover .project-section-row__media-arrow,
  .project-section-row__media-link:focus-visible
    .project-section-row__media-arrow {
    opacity: 1;
    transform: translateX(0) scale(1);
  }

  .project-section-row__media-link:focus-visible {
    outline: 2px solid var(--color-border, #888);
  }

  .project-section-row__media-link:focus:not(:focus-visible) {
    outline: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .project-section-row__media-link .photoMedia,
    .project-section-row__media-arrow {
      transition-duration: 0.01ms;
    }
  }

  .project-section-row__video--ambient {
    pointer-events: none;
  }

  .project-section-row__embed-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }

  .project-section-row__vidstack-wrap {
    aspect-ratio: 16 / 9;
    min-height: 200px;
  }

  .project-section-row__vidstack-wrap :global(.player) {
    width: 100%;
    height: 100%;
    min-height: inherit;
  }
</style>
