---
import ProjectPageContent from 'components/ProjectPageContent.astro'
import Layout from 'layouts/Base.astro'
import ProtectedLayout from 'layouts/Protected.astro'

import type { CollectionEntry } from 'astro:content'
import { renderMarkdown } from '../../utils/markdown'
import { withResolvedMediaWidths } from '../../utils/project-media'
import { resolveModeVisibility } from '../../schemas/project-outpost'
import { getProjectEntries } from '../../utils/project-data'

export async function getStaticPaths() {
  const content = await getProjectEntries()
  return content.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }))
}

const { entry } = Astro.props
const allProjects = await getProjectEntries()
const sorted = [...allProjects]
  .filter((project) => {
    const visibility = resolveModeVisibility(undefined, project.data.visibleIn)
    return visibility.default || visibility.outpost
  })
  .sort((a: CollectionEntry<'project'>, b: CollectionEntry<'project'>) => {
    const orderA = a.data.order ?? 999
    const orderB = b.data.order ?? 999
    if (orderA !== orderB) return orderA - orderB
    return b.data.date.getTime() - a.data.date.getTime()
  })
const currentIndex = sorted.findIndex((p) => p.slug === entry.slug)
const nextProject =
  currentIndex >= 0 && currentIndex < sorted.length - 1
    ? {
        slug: sorted[currentIndex + 1].slug,
        title: sorted[currentIndex + 1].data.title,
        thumbnail: sorted[currentIndex + 1].data.thumbnail,
      }
    : null
const prevProject =
  currentIndex > 0
    ? {
        slug: sorted[currentIndex - 1].slug,
        title: sorted[currentIndex - 1].data.title,
        thumbnail: sorted[currentIndex - 1].data.thumbnail,
      }
    : null
const sections = entry.data.sections ?? []
type ProjectSection = NonNullable<
  CollectionEntry<'project'>['data']['sections']
>[number]
const sectionRows = await Promise.all(
  sections.map(async (sec: ProjectSection) => ({
    title: sec.title,
    bodyHtml: sec.text?.trim()
      ? ((await renderMarkdown(sec.text)) as string)
      : '',
    media: withResolvedMediaWidths(
      sec.media,
      entry.data.mediaMaxWidth,
    ),
  })),
)

const pageTitle = `${entry.data.title} - Ryen Beatty - Design engineer`
const frontmatter = { ...entry.data, title: pageTitle }

const pageContentProps = {
  slug: entry.slug,
  thumbnail: entry.data.thumbnail,
  description: entry.data.description,
  heroImage: entry.data['hero-image'],
  sectionRows,
  nextProject,
  prevProject,
}
---

{
  entry.data.password ? (
    <ProtectedLayout password={entry.data.password} storageKey={entry.slug}>
      <Layout frontmatter={frontmatter}>
        <ProjectPageContent {...pageContentProps} />
      </Layout>
    </ProtectedLayout>
  ) : (
    <Layout frontmatter={frontmatter}>
      <ProjectPageContent {...pageContentProps} />
    </Layout>
  )
}
